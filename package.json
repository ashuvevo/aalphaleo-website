{
  "name": "aalphaleo-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./src/css/input.css -o ./out/assets/css/main.css --minify",
    "build:site": "node build/build.js",
    "build": "npm run build:css && npm run build:site",
    "audit:seo": "node scripts/audit-seo.js",
    "generate:blog-images": "node scripts/generate-blog-images.js",
