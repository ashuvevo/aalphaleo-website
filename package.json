    "publish:blogs": "node scripts/import-blogs.js",
    "generate:gallery": "node scripts/generate-gallery-demos.js",
    "generate:services": "node scripts/generate-service-images.js"
  },
  "devDependencies": {
    "marked": "^18.0.6",
